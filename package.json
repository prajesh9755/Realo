{
  "name": "true-scale-ar-preview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "See how online products look in real life, at true real-world scale, via live camera AR.",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run imgly:vendor && vite build",
    "preview": "vite preview --host",
    "verify:scale": "node scripts/verify-model-scale.mjs",
    "models:rescale": "node scripts/rescale-model.mjs",
    "models:calibration": "node scripts/make-calibration-models.mjs",
    "imgly:vendor": "node scripts/vendor-imgly.mjs",
    "photos": "node scripts/render-product-photos.mjs"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "vite": "^7.1.5"
  }
}
